// cookieattr.nv — a cookie's attributes, and the rules that make a
// combination of them one a browser accepts.
//
// A `Set-Cookie` header whose attributes contradict each other is not
// reported anywhere.  The browser ignores the cookie, the next request
// arrives without it, and the server sees a request with no session.
// RFC 6265bis names five such combinations:
//
//   a `__Host-` name with a `Domain` attribute (section 4.1.3.2);
//   a `__Host-` name whose `Path` is not `/` (section 4.1.3.2);
//   a `__Secure-` or `__Host-` name without `Secure` (section 4.1.3);
//   `SameSite=None` without `Secure` (section 5.6.7);
//   `Partitioned` without `Secure` (the CHIPS draft, section 2.1).
//
// `check_attrs` reports each of them, and every writer in `cookiewrite`
// refuses a set that fails it.
//
// The prefixes are the only host locking cookies have.  A cookie has a
// domain and no origin, so a cookie set by one host for a parent domain
// reaches every host under that domain.  A browser accepts a `__Host-`
// cookie only with `Secure`, `Path=/` and no `Domain`, which confines
// it to the host that set it.

use std.list
use std.str
use civil

// Where a cookie's name or value is, as a byte range into the header
// string the caller owns.
pub struct CookieSpan
    start: Int
    len: Int

// The `SameSite` attribute.
pub enum CookieSameSite
    // The attribute is absent.  The browser's own default then applies,
    // which is `Lax` in current browsers and was `None` in older ones.
    // A cookie that must be sent cross-site says `None` explicitly.
    CookieSameSiteAbsent
    // Sent only on same-site requests.
    CookieSameSiteStrict
    // Sent on same-site requests and on top-level cross-site
    // navigations with a safe method.
    CookieSameSiteLax
    // Sent on every request.  A browser accepts it only with `Secure`.
    CookieSameSiteNone

// Which name prefix a cookie carries, if any.
//
// The prefix is the first bytes of the name, so it is read off the name
// with `prefix_of` rather than stored beside it.
pub enum CookiePrefix
    // No prefix.
    CookiePrefixNone
    // `__Secure-`: the cookie must carry `Secure`.
    CookiePrefixSecure
    // `__Host-`: the cookie must carry `Secure`, must have `Path=/`,
    // and must have no `Domain`.
    CookiePrefixHost

// How long a cookie lives.
//
// A cookie with both `Expires` and `Max-Age` is governed by `Max-Age`
// (RFC 6265bis section 5.7 step 3), so the two are one choice here.
pub enum CookieLife
    // A session cookie: neither attribute.  The browser discards it
    // when it closes.
    CookieLifeSession
    // `Expires`, as a civil date-time in UTC.
    CookieLifeExpires(at: civil.CivilDateTime)
    // `Max-Age`, in seconds.  Zero or less means the cookie expires at
    // once, which is how a cookie is deleted.
    CookieLifeMaxAge(seconds: Int)

// Everything a `Set-Cookie` can say past the name and the value.
pub struct CookieAttrs
    // `Domain`, or empty when the attribute is absent.  An absent
    // `Domain` makes a host-only cookie, sent to the host that set it
    // and to no subdomain.  A present one is sent to every subdomain.
    domain: Str
    // `Path`, or empty when the attribute is absent.  With no `Path`
    // the browser computes a default from the request path.
    path_value: Str
    life: CookieLife
    secure: Bool
    http_only: Bool
    same_site: CookieSameSite
    // `Partitioned`: the cookie is kept separately for each top-level
    // site that embeds the page setting it.  A browser accepts it only
    // with `Secure`.
    partitioned: Bool

// The attributes a session cookie should have.
//
// `Path=/`, `Secure`, `HttpOnly`, `SameSite=Lax`, no `Domain`, and a
// session lifetime.
pub fn defaults() -> CookieAttrs []
    CookieAttrs { domain: "", path_value: "/", life: CookieLifeSession,
                  secure: true, http_only: true,
                  same_site: CookieSameSiteLax, partitioned: false }

// The attributes with none set: no `Domain`, no `Path`, a session
// lifetime and every flag off.
//
// This is what a `Set-Cookie` with no attributes parses into.  It is
// not `defaults()`.
pub fn empty_attrs() -> CookieAttrs []
    CookieAttrs { domain: "", path_value: "", life: CookieLifeSession,
                  secure: false, http_only: false,
                  same_site: CookieSameSiteAbsent, partitioned: false }

// Which prefix a name carries.
//
// The comparison is case-sensitive, as RFC 6265bis section 4.1.3 has
// a server write it: `__Host-` is the prefix and `__host-` is an
// ordinary name.
//
// ```novo
// use cookieattr
//
// fn main() [io]
//     match cookieattr.prefix_of("__Host-sid")
//         CookiePrefixHost   => println("host-locked")
//         CookiePrefixSecure => println("secure-only")
//         CookiePrefixNone   => println("ordinary")
// ```
pub fn prefix_of(name: Str) -> CookiePrefix []
    if str.starts_with(name, "__Host-")
        return CookiePrefixHost
    if str.starts_with(name, "__Secure-")
        return CookiePrefixSecure
    CookiePrefixNone

// Why a cookie is not one a browser will accept.
pub enum CookieError
    // A `__Host-` cookie with a `Domain`.
    CookieHostPrefixWithDomain(name: Str, domain: Str)
    // A `__Host-` cookie whose `Path` is not exactly `/`.
    CookieHostPrefixBadPath(name: Str, path_value: Str)
    // A `__Host-` or `__Secure-` cookie without `Secure`.
    CookiePrefixNeedsSecure(name: Str)
    // `SameSite=None` without `Secure`.
    CookieSameSiteNoneNeedsSecure(name: Str)
    // `Partitioned` without `Secure`.
    CookiePartitionedNeedsSecure(name: Str)
    // A byte the cookie-name grammar does not allow, at a byte offset
    // into the name.  A name is an RFC 9110 token (RFC 6265bis section
    // 4.1.1): no control, no space, and none of `()<>@,;:\"/[]?={}`.
    CookieBadNameByte(at: Int, byte: Int)
    // A byte the cookie-value grammar does not allow, at a byte offset
    // into the value: a control, a space, `"` other than a pair around
    // the whole value, `,`, `;`, `\`, or a byte above 0x7E.
    CookieBadValueByte(at: Int, byte: Int)
    // A `Domain` that is not a host name, or one the request host does
    // not domain-match when a jar stores it.
    CookieBadDomain(domain: Str)
    // A `Path` that does not begin with `/`, or that holds a control
    // byte or `;`.
    CookieBadPath(path_value: Str)
    // An `Expires` that none of RFC 6265bis section 5.1.1's rules read
    // as a date.
    CookieBadExpires(text: Str)
    // A `Max-Age` that is not an integer.
    CookieBadMaxAge(text: Str)
    // A header that is not a cookie: no `=`, an empty name, a control
    // byte, or a cookie longer than a jar stores.  `at` is the byte
    // offset where reading stopped.
    CookieMalformed(at: Int)
    // A signed or encrypted cookie that did not verify under any key
    // offered, or a key or nonce of the wrong length for the cipher.
    CookieSealBroken(name: Str)

// The standard `Error` implementation, so a refused cookie is reported
// by anything that reports errors.
impl Error for CookieError
    // One line: the cookie's name or the text at fault, what is wrong,
    // and what a browser does with it.
    fn message(self) -> Str
        match self
            CookieHostPrefixWithDomain(n, d) => "${n}: a __Host- cookie has no Domain, and a browser ignores it with Domain=${d}"
            CookieHostPrefixBadPath(n, p)    => "${n}: a __Host- cookie has Path=/, and a browser ignores it with Path=${p}"
            CookiePrefixNeedsSecure(n)       => "${n}: the name's prefix requires Secure, and a browser ignores the cookie without it"
            CookieSameSiteNoneNeedsSecure(n) => "${n}: SameSite=None requires Secure, and a browser ignores the cookie without it"
            CookiePartitionedNeedsSecure(n)  => "${n}: Partitioned requires Secure, and a browser ignores the cookie without it"
            CookieBadNameByte(at, b)         => "at ${at}: byte ${b} is not allowed in a cookie name"
            CookieBadValueByte(at, b)        => "at ${at}: byte ${b} is not allowed in a cookie value"
            CookieBadDomain(d)               => "`${d}` is not a Domain this cookie may have"
            CookieBadPath(p)                 => "`${p}` is not a Path: a Path begins with /"
            CookieBadExpires(t)              => "`${t}` is not a date"
            CookieBadMaxAge(t)               => "`${t}` is not a Max-Age: it is a whole number of seconds"
            CookieMalformed(at)              => "at ${at}: not a cookie"
            CookieSealBroken(n)              => "${n}: the sealed value did not verify under any key"

// Check a name and its attributes against the grammar and against every
// rule a browser applies.
//
// Answers every problem, in this order: the name, the `Domain`, the
// `Path`, then `browser_rules`.  An empty list means the combination is
// one a browser accepts.  The value is not an argument; the writers in
// `cookiewrite` check it.
//
// ```novo
// use cookieattr
// use std.list
//
// fn main() [io]
//     let a = cookieattr.defaults()
//     println(string_of_int(list.len(cookieattr.check_attrs("sid", a))))
// ```
pub fn check_attrs(name: Str, a: CookieAttrs) -> [CookieError] []
    var out: [CookieError] = []
    match name_error(name)
        Some(e) => list.push(out, e)
        None    => ()
    if str.len(a.domain) > 0 and not domain_text_ok(a.domain)
        list.push(out, CookieBadDomain(a.domain))
    if str.len(a.path_value) > 0 and not path_text_ok(a.path_value)
        list.push(out, CookieBadPath(a.path_value))
    list.append(out, browser_rules(name, a))
    out

// The rules a browser applies when it stores a cookie: the two
// prefixes, `SameSite=None` and `Partitioned`, each of which needs
// `Secure`.
//
// These are the rules a browser applies to a header it has already
// parsed, so the grammar is not among them.  `cookiejar.store` refuses
// a cookie that fails one.
pub fn browser_rules(name: Str, a: CookieAttrs) -> [CookieError] []
    var out: [CookieError] = []
    match prefix_of(name)
        CookiePrefixNone   => ()
        CookiePrefixSecure =>
            if not a.secure
                list.push(out, CookiePrefixNeedsSecure(name))
        CookiePrefixHost   =>
            if not a.secure
                list.push(out, CookiePrefixNeedsSecure(name))
            if str.len(a.domain) > 0
                list.push(out, CookieHostPrefixWithDomain(name, a.domain))
            if a.path_value != "/"
                list.push(out, CookieHostPrefixBadPath(name, a.path_value))
    if not a.secure
        if same_site_is_none(a.same_site)
            list.push(out, CookieSameSiteNoneNeedsSecure(name))
        if a.partitioned
            list.push(out, CookiePartitionedNeedsSecure(name))
    out

// Whether a name and its attributes pass every rule `check_attrs`
// applies.
pub fn attrs_ok(name: Str, a: CookieAttrs) -> Bool []
    list.len(check_attrs(name, a)) == 0

// The attributes a name's prefix requires, applied to a set.
//
// A `__Secure-` name gains `Secure`.  A `__Host-` name gains `Secure`
// and `Path=/` and loses its `Domain`.  A set with `SameSite=None` or
// `Partitioned` gains `Secure`.  Nothing else changes, so a grammar
// error `check_attrs` reports is still the caller's to fix.
pub fn apply_prefix(name: Str, a: CookieAttrs) -> CookieAttrs []
    var domain = a.domain
    var path_value = a.path_value
    var secure = a.secure or a.partitioned or same_site_is_none(a.same_site)
    match prefix_of(name)
        CookiePrefixNone   => ()
        CookiePrefixSecure =>
            secure = true
        CookiePrefixHost   =>
            secure = true
            domain = ""
            path_value = "/"
    CookieAttrs { domain: domain, path_value: path_value, life: a.life,
                  secure: secure, http_only: a.http_only,
                  same_site: a.same_site, partitioned: a.partitioned }

// Whether a byte may appear in a cookie name.
//
// RFC 6265bis section 4.1.1 makes a name an RFC 9110 `token`: a
// visible ASCII byte other than `()<>@,;:\"/[]?={}`.
pub fn name_byte_ok(byte: Int) -> Bool []
    if byte <= ' ' or byte >= 127
        return false
    not str.contains("()<>@,;:\\\"/[]?={}", str.from_byte(byte))

// Whether a byte may appear in a cookie value.
//
// RFC 6265bis section 4.1.1's `cookie-octet`: a visible ASCII byte
// other than `"`, `,`, `;` and `\`.  A value may hold `/`, `:` and `=`,
// which a name may not.
pub fn value_byte_ok(byte: Int) -> Bool []
    if byte <= ' ' or byte >= 127
        return false
    byte != '"' and byte != ',' and byte != ';' and byte != '\\'

// The `SameSite` attribute's value as a header spells it, or the empty
// string for an absent one.
pub fn same_site_name(s: CookieSameSite) -> Str []
    match s
        CookieSameSiteAbsent => ""
        CookieSameSiteStrict => "Strict"
        CookieSameSiteLax    => "Lax"
        CookieSameSiteNone   => "None"

// The `SameSite` a header's value names, compared case-insensitively,
// or `CookieSameSiteAbsent` for a value this package does not know.
//
// RFC 6265bis section 5.6.7 has a browser treat an unknown value as
// the default, which is what absent means.
pub fn same_site_named(text: Str) -> CookieSameSite []
    let t = str.lower(text)
    if t == "strict"
        return CookieSameSiteStrict
    if t == "lax"
        return CookieSameSiteLax
    if t == "none"
        return CookieSameSiteNone
    CookieSameSiteAbsent

// Whether a `SameSite` is `None`.
fn same_site_is_none(s: CookieSameSite) -> Bool
    match s
        CookieSameSiteNone => true
        _                  => false

// The first thing wrong with a name, if anything is.
fn name_error(name: Str) -> ?CookieError
    if str.len(name) == 0
        return Some(CookieMalformed(0))
    for i in 0..str.len(name)
        let b = str.byte_at_or(name, i, 0)
        if not name_byte_ok(b)
            return Some(CookieBadNameByte(i, b))
    None

// Whether a `Domain` value is a host name: labels of ASCII letters,
// digits, `-` and `_`, separated by single dots, with one optional
// leading dot.
fn domain_text_ok(d: Str) -> Bool
    var from = 0
    if str.byte_at_or(d, 0, 0) == '.'
        from = 1
    let n = str.len(d)
    if from >= n
        return false
    var label = 0
    for i in from..n
        let b = str.byte_at_or(d, i, 0)
        if b == '.'
            if label == 0
                return false
            label = 0
        else if host_byte_ok(b)
            label = label + 1
        else
            return false
    true

// Whether a byte may stand in a host name label.
fn host_byte_ok(b: Int) -> Bool
    b >= 'a' and b <= 'z' or b >= 'A' and b <= 'Z' or b >= '0' and b <= '9' or b == '-' or b == '_'

// Whether a `Path` value may be written: it begins with `/` and holds
// no control byte and no `;` (RFC 6265bis section 4.1.1, `path-value`).
fn path_text_ok(p: Str) -> Bool
    if str.byte_at_or(p, 0, 0) != '/'
        return false
    for i in 0..str.len(p)
        let b = str.byte_at_or(p, i, 0)
        if b < ' ' or b == 127 or b == ';'
            return false
    true
