// cookieattr_tests.nv — the attribute rules, including the five
// combinations a browser drops without reporting anything.
//
// The prefix cases are RFC 6265bis section 4.1.3's own examples.

use std.test
use std.list
use cookieattr

fn host_attrs() -> cookieattr.CookieAttrs
    CookieAttrs { domain: "", path_value: "/", life: CookieLifeSession,
                  secure: true, http_only: true, same_site: CookieSameSiteLax,
                  partitioned: false }

fn attrs(domain: Str, path_value: Str, secure: Bool) -> cookieattr.CookieAttrs
    CookieAttrs { domain: domain, path_value: path_value, life: CookieLifeSession,
                  secure: secure, http_only: false, same_site: CookieSameSiteAbsent,
                  partitioned: false }

@test
fn test_the_defaults_and_the_empty_set() [io]
    let a = cookieattr.defaults()

    test.case("the defaults are Path=/, Secure, HttpOnly, SameSite=Lax, no Domain, a session")
    test.assert(a.path_value == "/")
    test.assert(a.domain == "")
    test.assert(a.secure)
    test.assert(a.http_only)
    test.assert(cookieattr.same_site_name(a.same_site) == "Lax")
    match a.life
        CookieLifeSession => test.assert(true)
        _                 => test.assert(false)

    test.case("the empty set has no Path and every flag off")
    let e = cookieattr.empty_attrs()
    test.assert(e.path_value == "")
    test.assert(e.secure == false)
    test.assert(e.http_only == false)
    test.assert(cookieattr.same_site_name(e.same_site) == "")

@test
fn test_the_prefix_is_read_off_the_name_case_sensitively() [io]
    test.case("__Host- is the host-locked prefix")
    match cookieattr.prefix_of("__Host-sid")
        CookiePrefixHost => test.assert(true)
        _                => test.assert(false)

    test.case("__Secure- requires Secure")
    match cookieattr.prefix_of("__Secure-sid")
        CookiePrefixSecure => test.assert(true)
        _                  => test.assert(false)

    test.case("an ordinary name has no prefix")
    match cookieattr.prefix_of("sid")
        CookiePrefixNone => test.assert(true)
        _                => test.assert(false)

    test.case("__host- is an ordinary name")
    match cookieattr.prefix_of("__host-sid")
        CookiePrefixNone => test.assert(true)
        _                => test.assert(false)

@test
fn test_rfc_6265bis_section_4_1_3_prefix_examples() [io]
    test.case("__Secure-SID=12345; Domain=site.example is rejected: no Secure")
    test.assert(cookieattr.attrs_ok("__Secure-SID", attrs("site.example", "", false)) == false)

    test.case("__Secure-SID=12345; Secure; Domain=site.example is accepted")
    test.assert(cookieattr.attrs_ok("__Secure-SID", attrs("site.example", "", true)))

    test.case("__Host-SID=12345 is rejected")
    test.assert(cookieattr.attrs_ok("__Host-SID", attrs("", "", false)) == false)

    test.case("__Host-SID=12345; Secure is rejected: no Path=/")
    test.assert(cookieattr.attrs_ok("__Host-SID", attrs("", "", true)) == false)

    test.case("__Host-SID=12345; Domain=site.example is rejected")
    test.assert(cookieattr.attrs_ok("__Host-SID", attrs("site.example", "", false)) == false)

    test.case("__Host-SID=12345; Domain=site.example; Path=/ is rejected")
    test.assert(cookieattr.attrs_ok("__Host-SID", attrs("site.example", "/", false)) == false)

    test.case("__Host-SID=12345; Secure; Domain=site.example; Path=/ is rejected")
    test.assert(cookieattr.attrs_ok("__Host-SID", attrs("site.example", "/", true)) == false)

    test.case("__Host-SID=12345; Secure; Path=/ is accepted")
    test.assert(cookieattr.attrs_ok("__Host-SID", attrs("", "/", true)))

@test
fn test_every_silently_dropped_combination_is_refused() [io]
    test.case("__Host- with a Domain")
    let d = CookieAttrs { domain: "example.com", path_value: "/", life: CookieLifeSession,
                          secure: true, http_only: true, same_site: CookieSameSiteLax,
                          partitioned: false }
    match list.first(cookieattr.check_attrs("__Host-sid", d))
        Some(e) =>
            match e
                CookieHostPrefixWithDomain(n, dom) =>
                    test.assert(n == "__Host-sid")
                    test.assert(dom == "example.com")
                _                                  => test.assert(false)
        None    => test.assert(false)

    test.case("__Host- with a Path that is not exactly /")
    test.assert(cookieattr.attrs_ok("__Host-sid", attrs("", "/admin", true)) == false)

    test.case("__Secure- without Secure")
    test.assert(cookieattr.attrs_ok("__Secure-sid", attrs("", "/", false)) == false)

    test.case("SameSite=None without Secure")
    let n = CookieAttrs { domain: "", path_value: "/", life: CookieLifeSession,
                          secure: false, http_only: true, same_site: CookieSameSiteNone,
                          partitioned: false }
    match list.first(cookieattr.check_attrs("sid", n))
        Some(e) =>
            match e
                CookieSameSiteNoneNeedsSecure(name) => test.assert(name == "sid")
                _                                   => test.assert(false)
        None    => test.assert(false)

    test.case("Partitioned without Secure")
    let pt = CookieAttrs { domain: "", path_value: "/", life: CookieLifeSession,
                           secure: false, http_only: true, same_site: CookieSameSiteLax,
                           partitioned: true }
    test.assert(cookieattr.attrs_ok("sid", pt) == false)

    test.case("the same attributes with Secure pass")
    test.assert(cookieattr.attrs_ok("__Host-sid", host_attrs()))
    test.assert(list.len(cookieattr.browser_rules("sid", cookieattr.apply_prefix("sid", n))) == 0)
    test.assert(list.len(cookieattr.browser_rules("sid", cookieattr.apply_prefix("sid", pt))) == 0)

@test
fn test_the_check_answers_every_problem() [io]
    test.case("a __Host- cookie with a Domain, a bad Path and no Secure reports three")
    test.assert(list.len(cookieattr.check_attrs("__Host-sid", attrs("example.com", "/admin", false))) == 3)

    test.case("the grammar comes first: the name, the Domain, the Path")
    let es = cookieattr.check_attrs("a b", attrs("exa mple.com", "admin", true))
    test.assert(list.len(es) == 3)
    match es[0]
        CookieBadNameByte(at, b) =>
            test.assert(at == 1)
            test.assert(b == ' ')
        _                        => test.assert(false)
    match es[1]
        CookieBadDomain(dom) => test.assert(dom == "exa mple.com")
        _                    => test.assert(false)
    match es[2]
        CookieBadPath(p) => test.assert(p == "admin")
        _                => test.assert(false)

    test.case("an empty name is not a cookie")
    match list.first(cookieattr.check_attrs("", cookieattr.defaults()))
        Some(e) =>
            match e
                CookieMalformed(at) => test.assert(at == 0)
                _                   => test.assert(false)
        None    => test.assert(false)

    test.case("a Domain is labels of letters, digits, `-` and `_`, with one optional leading dot")
    test.assert(cookieattr.attrs_ok("sid", attrs(".example.com", "/", true)))
    test.assert(cookieattr.attrs_ok("sid", attrs("a_b-c.Example.com", "/", true)))
    test.assert(cookieattr.attrs_ok("sid", attrs(".", "/", true)) == false)
    test.assert(cookieattr.attrs_ok("sid", attrs("a..b", "/", true)) == false)

    test.case("a Path holds no control byte and no semicolon")
    test.assert(cookieattr.attrs_ok("sid", attrs("", "/a;b", true)) == false)
    test.assert(cookieattr.attrs_ok("sid", attrs("", "/a\tb", true)) == false)
    test.assert(cookieattr.attrs_ok("sid", attrs("", "/a b", true)))

@test
fn test_the_repair_is_published_beside_the_check() [io]
    test.case("apply_prefix makes a __Host- attribute set pass")
    let fixed = cookieattr.apply_prefix("__Host-sid", attrs("example.com", "/admin", false))
    test.assert(fixed.domain == "")
    test.assert(fixed.path_value == "/")
    test.assert(fixed.secure)
    test.assert(cookieattr.attrs_ok("__Host-sid", fixed))

    test.case("a __Secure- name gains Secure and keeps its Domain and Path")
    let s = cookieattr.apply_prefix("__Secure-sid", attrs("example.com", "/admin", false))
    test.assert(s.secure)
    test.assert(s.domain == "example.com")
    test.assert(s.path_value == "/admin")

    test.case("an ordinary name is left as it was")
    let o = cookieattr.apply_prefix("sid", attrs("example.com", "/admin", false))
    test.assert(o.secure == false)
    test.assert(o.domain == "example.com")

@test
fn test_the_name_and_value_grammars_differ() [io]
    test.case("a name is an RFC 9110 token")
    test.assert(cookieattr.name_byte_ok('a'))
    test.assert(cookieattr.name_byte_ok('!'))
    test.assert(cookieattr.name_byte_ok('=') == false)
    test.assert(cookieattr.name_byte_ok(';') == false)
    test.assert(cookieattr.name_byte_ok(' ') == false)
    test.assert(cookieattr.name_byte_ok('/') == false)
    test.assert(cookieattr.name_byte_ok(127) == false)

    test.case("a value may hold `/`, `:` and `=`")
    test.assert(cookieattr.value_byte_ok('/'))
    test.assert(cookieattr.value_byte_ok(':'))
    test.assert(cookieattr.value_byte_ok('='))

    test.case("and may not hold `;`, `,`, a double quote, a backslash, a space or a control byte")
    test.assert(cookieattr.value_byte_ok(';') == false)
    test.assert(cookieattr.value_byte_ok(',') == false)
    test.assert(cookieattr.value_byte_ok('"') == false)
    test.assert(cookieattr.value_byte_ok('\\') == false)
    test.assert(cookieattr.value_byte_ok(' ') == false)
    test.assert(cookieattr.value_byte_ok('\n') == false)
    test.assert(cookieattr.value_byte_ok(200) == false)

@test
fn test_samesite_is_spelled_as_a_header_spells_it() [io]
    test.case("the names are the header's spellings")
    test.assert(cookieattr.same_site_name(CookieSameSiteStrict) == "Strict")
    test.assert(cookieattr.same_site_name(CookieSameSiteLax) == "Lax")
    test.assert(cookieattr.same_site_name(CookieSameSiteNone) == "None")
    test.assert(cookieattr.same_site_name(CookieSameSiteAbsent) == "")

    test.case("reading ignores case")
    test.assert(cookieattr.same_site_name(cookieattr.same_site_named("strict")) == "Strict")
    test.assert(cookieattr.same_site_name(cookieattr.same_site_named("LAX")) == "Lax")
    test.assert(cookieattr.same_site_name(cookieattr.same_site_named("nOnE")) == "None")

    test.case("an unknown value is absent, as RFC 6265bis section 5.6.7 has a browser read it")
    test.assert(cookieattr.same_site_name(cookieattr.same_site_named("Sometimes")) == "")

@test
fn test_every_error_has_a_one_line_message() [io]
    let es = [CookieHostPrefixWithDomain("__Host-a", "x.com"),
              CookieHostPrefixBadPath("__Host-a", "/p"),
              CookiePrefixNeedsSecure("__Secure-a"),
              CookieSameSiteNoneNeedsSecure("a"),
              CookiePartitionedNeedsSecure("a"),
              CookieBadNameByte(1, 32),
              CookieBadValueByte(2, 59),
              CookieBadDomain("x y"),
              CookieBadPath("p"),
              CookieBadExpires("soon"),
              CookieBadMaxAge("ten"),
              CookieMalformed(0),
              CookieSealBroken("sid")]
    test.case("each message is one line and names what is wrong")
    for e in es
        let m = e.message()
        test.assert(m != "")
        test.assert(str.contains(m, "\n") == false)
    test.assert(str.contains(es[0].message(), "Domain=x.com"))
    test.assert(str.contains(es[5].message(), "cookie name"))
    test.assert(str.contains(es[12].message(), "sid"))
