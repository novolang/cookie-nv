// cookieattr_tests.nv — the attribute rules, and the headers a browser
// silently drops.
//
// RED ON PURPOSE: every body under `src/` is a `todo()`, so every
// assertion here reaches `not implemented: cookie-nv.<module>.<fn>`.
//
// THE CASES ARE THE ONES A BROWSER IGNORES WITHOUT SAYING SO.  Every
// combination below is accepted by every cookie library that has a
// `to_string` which cannot fail, is emitted onto the wire, and is then
// dropped by the browser with no error anywhere — so the server sees a
// request with no session and concludes the user logged out.  A suite
// made of well-formed cookies would prove nothing about the one thing
// this package is for.

use std.test
use std.list
use cookieattr
use cookieparse
use cookiewrite

fn host_attrs() -> cookieattr.CookieAttrs
    CookieAttrs { domain: "", path_value: "/",
                             life: CookieLifeSession, secure: true,
                             http_only: true, same_site: CookieSameSiteLax,
                             partitioned: false }

@test
fn test_the_defaults_are_the_combination_almost_nobody_writes() [io]
    let a = cookieattr.defaults()

    test.case("Path=/ — the browser's own default scopes a cookie to a directory")
    test.assert(a.path_value == "/")

    test.case("no Domain, which is what host-only means")
    test.assert(a.domain == "")

    test.case("Secure and HttpOnly")
    test.assert(a.secure)
    test.assert(a.http_only)

    test.case("SameSite=Lax, which is what a session cookie wants")
    match a.same_site
        CookieSameSiteLax => test.assert(true)
        _                 => test.assert(false)

    test.case("and a session lifetime")
    match a.life
        CookieLifeSession => test.assert(true)
        _                 => test.assert(false)

    test.case("the empty set is a different thing, and the two names say which was meant")
    let e = cookieattr.empty_attrs()
    test.assert(e.path_value == "")
    test.assert(e.secure == false)

@test
fn test_the_prefix_is_read_off_the_name_and_the_comparison_is_case_sensitive() [io]
    test.case("__Host- is the host-locked prefix")
    match cookieattr.prefix_of("__Host-sid")
        CookiePrefixHost => test.assert(true)
        _                => test.assert(false)

    test.case("__Secure- requires Secure and nothing more")
    match cookieattr.prefix_of("__Secure-sid")
        CookiePrefixSecure => test.assert(true)
        _                  => test.assert(false)

    test.case("an ordinary name has no prefix")
    match cookieattr.prefix_of("sid")
        CookiePrefixNone => test.assert(true)
        _                => test.assert(false)

    test.case("and __host- is an ordinary name, because browsers compare case-sensitively")
    match cookieattr.prefix_of("__host-sid")
        CookiePrefixNone => test.assert(true)
        _                => test.assert(false)

@test
fn test_every_silently_dropped_combination_is_refused_here() [io]
    test.case("__Host- with a Domain — the prefix means host-locked and Domain means the opposite")
    var a = host_attrs()
    a = CookieAttrs { domain: "example.com", path_value: a.path_value,
                                 life: a.life, secure: a.secure,
                                 http_only: a.http_only, same_site: a.same_site,
                                 partitioned: a.partitioned }
    test.assert(cookieattr.attrs_ok("__Host-sid", a) == false)
    match list.first(cookieattr.check_attrs("__Host-sid", a))
        Some(e) =>
            match e
                CookieHostPrefixWithDomain(n, d) =>
                    test.assert(n == "__Host-sid")
                    test.assert(d == "example.com")
                _                                => test.assert(false)
        None    => test.assert(false)

    test.case("__Host- with a Path that is not exactly /")
    var p = host_attrs()
    p = CookieAttrs { domain: "", path_value: "/admin", life: p.life,
                                 secure: p.secure, http_only: p.http_only,
                                 same_site: p.same_site, partitioned: p.partitioned }
    test.assert(cookieattr.attrs_ok("__Host-sid", p) == false)

    test.case("__Secure- without Secure")
    var s = host_attrs()
    s = CookieAttrs { domain: s.domain, path_value: s.path_value,
                                 life: s.life, secure: false,
                                 http_only: s.http_only, same_site: s.same_site,
                                 partitioned: s.partitioned }
    test.assert(cookieattr.attrs_ok("__Secure-sid", s) == false)

    test.case("SameSite=None without Secure — the `works locally, not in production` bug")
    var n = cookieattr.empty_attrs()
    n = CookieAttrs { domain: "", path_value: "/", life: CookieLifeSession,
                                 secure: false, http_only: true,
                                 same_site: CookieSameSiteNone, partitioned: false }
    test.assert(cookieattr.attrs_ok("sid", n) == false)

    test.case("Partitioned without Secure")
    var pt = CookieAttrs { domain: "", path_value: "/",
                                      life: CookieLifeSession, secure: false,
                                      http_only: true, same_site: CookieSameSiteLax,
                                      partitioned: true }
    test.assert(cookieattr.attrs_ok("sid", pt) == false)

    test.case("and a correct __Host- cookie passes, so the check is not refusing everything")
    test.assert(cookieattr.attrs_ok("__Host-sid", host_attrs()))

@test
fn test_the_check_answers_every_problem_rather_than_the_first() [io]
    // A caller building a cookie wrongly has usually got two attributes
    // wrong, and fixing one at a time is two deploys.
    test.case("a __Host- cookie with a Domain, a bad Path and no Secure reports three")
    let bad = CookieAttrs { domain: "example.com", path_value: "/admin",
                                       life: CookieLifeSession, secure: false,
                                       http_only: true, same_site: CookieSameSiteLax,
                                       partitioned: false }
    test.assert(list.len(cookieattr.check_attrs("__Host-sid", bad)) == 3)

@test
fn test_the_repair_is_published_beside_the_check() [io]
    // A caller that wants a __Host- cookie and does not want to
    // remember three rules should not have to turn the check off.
    test.case("apply_prefix makes a __Host- attribute set pass")
    let bad = CookieAttrs { domain: "example.com", path_value: "/admin",
                                       life: CookieLifeSession, secure: false,
                                       http_only: true, same_site: CookieSameSiteLax,
                                       partitioned: false }
    let fixed = cookieattr.apply_prefix("__Host-sid", bad)
    test.assert(fixed.domain == "")
    test.assert(fixed.path_value == "/")
    test.assert(fixed.secure)
    test.assert(cookieattr.attrs_ok("__Host-sid", fixed))

@test
fn test_the_name_and_value_grammars_are_different_and_the_difference_matters() [io]
    test.case("a name is an RFC 9110 token: no separators")
    test.assert(cookieattr.name_byte_ok(0x61))
    test.assert(cookieattr.name_byte_ok(0x3D) == false)
    test.assert(cookieattr.name_byte_ok(0x3B) == false)
    test.assert(cookieattr.name_byte_ok(0x20) == false)

    test.case("a value may hold `/`, `:` and `=`, which is why a JWT goes in one unencoded")
    test.assert(cookieattr.value_byte_ok(0x2F))
    test.assert(cookieattr.value_byte_ok(0x3A))
    test.assert(cookieattr.value_byte_ok(0x3D))

    test.case("and may not hold a semicolon, a comma, a space or a control byte")
    test.assert(cookieattr.value_byte_ok(0x3B) == false)
    test.assert(cookieattr.value_byte_ok(0x2C) == false)
    test.assert(cookieattr.value_byte_ok(0x20) == false)
    test.assert(cookieattr.value_byte_ok(0x0A) == false)

@test
fn test_samesite_absent_is_not_samesite_lax() [io]
    // Absent means the browser's own default applies, which is Lax now
    // and was None before — so a cookie that must be cross-site says
    // None rather than saying nothing.
    test.case("the names are the header's spellings")
    test.assert(cookieattr.same_site_name(CookieSameSiteLax) == "Lax")
    test.assert(cookieattr.same_site_name(CookieSameSiteNone) == "None")
    test.assert(cookieattr.same_site_name(CookieSameSiteAbsent) == "")

    test.case("parsing follows the header's own case-insensitivity")
    match cookieattr.same_site_named("strict")
        CookieSameSiteStrict => test.assert(true)
        _                    => test.assert(false)

    test.case("and an unknown value is absent rather than refused, which is what a browser does")
    match cookieattr.same_site_named("Sometimes")
        CookieSameSiteAbsent => test.assert(true)
        _                    => test.assert(false)

@test
fn test_a_writer_that_cannot_fail_is_a_writer_that_emits_dropped_cookies() [io]
    test.case("the checked writer refuses a __Host- cookie with a Domain")
    let bad = CookieAttrs { domain: "example.com", path_value: "/",
                                       life: CookieLifeSession, secure: true,
                                       http_only: true, same_site: CookieSameSiteLax,
                                       partitioned: false }
    match cookiewrite.set_cookie("__Host-sid", "x", bad)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("and the unchecked one writes it, because a proxy and a test both need that")
    test.assert(cookiewrite.set_cookie_unchecked("__Host-sid", "x", bad) != "")

    test.case("a correct cookie comes out in the order the RFC writes the attributes")
    match cookiewrite.set_cookie("sid", "abc", cookieattr.defaults())
        Ok(h)  => test.assert(h == "sid=abc; Path=/; Secure; HttpOnly; SameSite=Lax")
        Err(_) => test.assert(false)

    test.case("the length is answerable before the write, so a buffer can be sized")
    test.assert(cookiewrite.set_cookie_len("sid", "abc", cookieattr.defaults()) == 49)

    test.case("and the buffer form appends into a cursor the caller owns")
    var dst = bytes.cursor_be(bytes.zeros(128))
    match cookiewrite.set_cookie_into("sid", "abc", cookieattr.defaults(), dst)
        Ok(n)  => test.assert(n == 49)
        Err(_) => test.assert(false)

@test
fn test_deleting_a_cookie_means_matching_the_one_that_was_set() [io]
    // A cookie set with Domain and Path=/app is not deleted by a header
    // with neither: the browser keys on the triple, so the deletion
    // lands on a different cookie.
    test.case("delete_cookie keeps the attributes it was handed and adds the expiry")
    match cookiewrite.delete_cookie("sid", cookieattr.defaults())
        Ok(h)  => test.assert(h == "sid=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Lax")
        Err(_) => test.assert(false)

    test.case("and it refuses the same combinations set_cookie does")
    let bad = CookieAttrs { domain: "example.com", path_value: "/",
                                       life: CookieLifeSession, secure: true,
                                       http_only: true, same_site: CookieSameSiteLax,
                                       partitioned: false }
    match cookiewrite.delete_cookie("__Host-sid", bad)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_quoting_is_only_applied_where_it_makes_a_value_legal() [io]
    test.case("a value that needs no quotes keeps none")
    match cookiewrite.quote_value("abc")
        Ok(v)  => test.assert(v == "abc")
        Err(_) => test.assert(false)

    test.case("a control byte cannot be quoted into legality, so it is refused")
    match cookiewrite.quote_value("a\nb")
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("the client direction writes pairs and no attributes")
    match cookiewrite.cookie_header([("sid", "abc"), ("theme", "dark")])
        Ok(h)  => test.assert(h == "sid=abc; theme=dark")
        Err(_) => test.assert(false)

    test.case("and refuses a pair the grammar does not allow")
    match cookiewrite.cookie_header([("sid", "a;b")])
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("an Expires is written in the one spelling the RFC requires of a server")
    match cookieparse.parse_expires("Sun, 06 Nov 1994 08:49:37 GMT")
        Ok(dt) => test.assert(cookiewrite.format_expires(dt)
                              == "Sun, 06 Nov 1994 08:49:37 GMT")
        Err(_) => test.assert(false)
