// cookieseal_tests.nv — signed values, encrypted values, and key
// rotation.
//
// The expected MAC and key bytes come from Python's hmac module.  The
// cipher below is a stand-in for an AEAD that returns the plaintext
// unchanged, so the suite can check the layout, the name binding and
// the key handling around a caller's cipher.  It is not encryption, and nothing here
// asserts anything about a real cipher.

use std.test
use cookieseal

fn toy_seal(key: Bytes, nonce: Bytes, aad: Bytes, plain: Bytes) -> Bytes
    bytes.clone(plain)

fn toy_open(key: Bytes, nonce: Bytes, aad: Bytes, sealed: Bytes) -> ?Bytes
    Some(bytes.clone(sealed))

fn refusing_open(key: Bytes, nonce: Bytes, aad: Bytes, sealed: Bytes) -> ?Bytes
    None

fn toy_cipher() -> cookieseal.CookieCipher
    cookieseal.cipher("toy", 32, 12, 16, toy_seal, toy_open)

fn a_key() -> Bytes
    bytes.zeros(32)

fn another_key() -> Bytes
    bytes.fill(bytes.zeros(32), 0, 32, 1)

@test
fn test_a_key_set_is_a_list_newest_first() [io]
    test.case("one key is a key set of one")
    test.assert(cookieseal.key_count(cookieseal.one_key(a_key())) == 1)

    test.case("a rotation puts the new key in front and keeps the old")
    let k = cookieseal.rotate(cookieseal.one_key(a_key()), another_key())
    test.assert(cookieseal.key_count(k) == 2)
    test.assert(bytes.to_hex(k.keys[0]) == bytes.to_hex(another_key()))

    test.case("a key is as long as SHA-256's output")
    test.assert(cookieseal.key_len() == 32)
    test.assert(cookieseal.master_len() == 32)

    test.case("a list goes in as written")
    test.assert(cookieseal.key_count(cookieseal.keys_of([a_key(), another_key()])) == 2)

@test
fn test_the_tag_is_hmac_sha256_over_the_name_and_the_value() [io]
    // The expected value is Python's hmac module over the same bytes,
    // encoded with base64.urlsafe_b64encode and its padding removed.
    let k = cookieseal.one_key(bytes.from_str("Jefe"))
    let sealed = cookieseal.sign("a", "what do ya want for nothing?", k)
    test.case("the sealed value is the tag and then the value, as base64url")
    test.assert(sealed == "3Vf7O-tGDiqQ8mbvwcWvB6MeYfxJIBStWyVAXfD4eKh3aGF0IGRvIHlhIHdhbnQgZm9yIG5vdGhpbmc_")

@test
fn test_signing_lets_the_client_read_and_not_change() [io]
    let k = cookieseal.one_key(a_key())

    test.case("a signed value round-trips, and the index says which key matched")
    let sealed = cookieseal.sign("sid", "u=42", k)
    match cookieseal.verify("sid", sealed, k)
        Ok(pair) =>
            test.assert(pair.0 == "u=42")
            test.assert(pair.1 == 0)
        Err(_)   => test.assert(false)

    test.case("the client can read it")
    test.assert(cookieseal.peek_signed(sealed) == Some("u=42"))
    test.assert(cookieseal.peek_signed("AAAA") == None)
    test.assert(cookieseal.peek_signed("not base64url!") == None)

    test.case("and cannot change it")
    match cookieseal.verify("sid", sealed + "x", k)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match cookieseal.verify("sid", "AAAA", k)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a value that was not sealed here is told apart from one that was changed")
    test.assert(cookieseal.is_sealed(sealed))
    test.assert(cookieseal.is_sealed("plain") == false)
    test.assert(cookieseal.is_sealed("a+b/c=") == false)
    test.assert(cookieseal.is_sealed("AAAA") == false)

    test.case("an empty key set signs nothing, and nothing verifies under it")
    test.assert(cookieseal.sign("sid", "u=42", cookieseal.keys_of([])) == "")
    match cookieseal.verify("sid", sealed, cookieseal.keys_of([]))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_the_cookie_name_is_authenticated() [io]
    let k = cookieseal.one_key(a_key())

    test.case("a value signed for one name does not verify under another")
    let sealed = cookieseal.sign("role", "user", k)
    match cookieseal.verify("admin", sealed, k)
        Ok(_)  => test.assert(false)
        Err(e) =>
            match e
                CookieSealBroken(n) => test.assert(n == "admin")
                _                   => test.assert(false)

    test.case("and verifies under the name it was signed for")
    match cookieseal.verify("role", sealed, k)
        Ok(pair) => test.assert(pair.0 == "user")
        Err(_)   => test.assert(false)

@test
fn test_a_rotated_key_still_verifies() [io]
    let old = cookieseal.one_key(a_key())
    let sealed_before = cookieseal.sign("sid", "u=42", old)
    let rotated = cookieseal.rotate(old, another_key())

    test.case("a cookie signed before the rotation verifies after it, under the old key")
    match cookieseal.verify("sid", sealed_before, rotated)
        Ok(pair) =>
            test.assert(pair.0 == "u=42")
            test.assert(pair.1 == 1)
        Err(_)   => test.assert(false)

    test.case("a cookie signed after it verifies under the new key")
    match cookieseal.verify("sid", cookieseal.sign("sid", "u=42", rotated), rotated)
        Ok(pair) => test.assert(pair.1 == 0)
        Err(_)   => test.assert(false)

    test.case("a key that is off the list no longer verifies")
    match cookieseal.verify("sid", sealed_before, cookieseal.one_key(another_key()))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_encryption_composes_a_cipher_the_caller_supplies() [io]
    let k = cookieseal.one_key(a_key())
    let c = toy_cipher()
    let nonce = bytes.zeros(12)

    test.case("the nonce length is the cipher's")
    test.assert(cookieseal.nonce_len(c) == 12)

    test.case("an encrypted value round-trips through the caller's cipher")
    match cookieseal.encrypt("sid", "internal-42", k, c, nonce)
        Ok(sealed) =>
            test.assert(cookieseal.is_sealed(sealed))
            match cookieseal.decrypt("sid", sealed, k, c)
                Ok(pair) =>
                    test.assert(pair.0 == "internal-42")
                    test.assert(pair.1 == 0)
                Err(_)   => test.assert(false)
            test.case("the name is bound, so a moved value does not open")
            match cookieseal.decrypt("other", sealed, k, c)
                Ok(_)  => test.assert(false)
                Err(_) => test.assert(true)
            test.case("a cipher that refuses the tag refuses the value")
            match cookieseal.decrypt("sid", sealed, k, cookieseal.cipher("no", 32, 12, 16, toy_seal, refusing_open))
                Ok(_)  => test.assert(false)
                Err(_) => test.assert(true)
            test.case("a key of the wrong length is not tried")
            match cookieseal.decrypt("sid", sealed, cookieseal.one_key(bytes.zeros(16)), c)
                Ok(_)  => test.assert(false)
                Err(_) => test.assert(true)
        Err(_)     => test.assert(false)

    test.case("a value shorter than the nonce is refused")
    match cookieseal.decrypt("sid", "AAAA", k, c)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

    test.case("a nonce or a key of the wrong length is refused rather than padded")
    match cookieseal.encrypt("sid", "x", k, c, bytes.zeros(8))
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)
    match cookieseal.encrypt("sid", "x", cookieseal.one_key(bytes.zeros(16)), c, nonce)
        Ok(_)  => test.assert(false)
        Err(_) => test.assert(true)

@test
fn test_one_secret_becomes_two_keys() [io]
    let d = cookieseal.derive(a_key())

    test.case("the signing key and the encryption key are different")
    test.assert(bytes.len(d.signing) == 32)
    test.assert(bytes.len(d.encryption) == 32)
    test.assert(bytes.to_hex(d.signing) != bytes.to_hex(d.encryption))

    test.case("neither is the master")
    test.assert(bytes.to_hex(d.signing) != bytes.to_hex(a_key()))

    test.case("each is one HKDF-Expand block (RFC 5869), checked with Python's hmac module")
    test.assert(bytes.to_hex(d.signing) == "715c951462f7f053f0da5c9052d534e91abc56c5859f9d395738a353fff7c7fe")
