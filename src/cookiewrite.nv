// cookiewrite.nv — a `Set-Cookie` header written, with the rules a
// browser applies checked first.
//
// Every writer here answers a `Result`.  A `Set-Cookie` that breaks one
// of the rules in `cookieattr` is dropped by the browser without any
// report, so the writer refuses it instead.  `set_cookie_unchecked`
// writes anything, for a proxy passing a header through and for a test
// that wants a malformed one.
//
// The attributes are written in the order RFC 6265bis section 4.1.1
// lists them: `Domain`, `Path`, `Expires` or `Max-Age`, `Secure`,
// `HttpOnly`, `SameSite` and `Partitioned`.  An `Expires` is written in
// the one form section 4.1.1 allows a server, the RFC 1123 date of RFC
// 9110 section 5.6.7: `Sun, 06 Nov 1994 08:49:37 GMT`.

use std.bytes
use std.list
use std.str
use civil
use cookieattr
use cookieparse

// Write a `Set-Cookie` header value, everything after `Set-Cookie: `.
//
// Refuses the first of `cookieattr.check_attrs`'s problems, then a
// value the `cookie-value` grammar does not allow.
//
// ```novo
// use cookieattr
// use cookiewrite
//
// fn main() [io]
//     match cookiewrite.set_cookie("sid", "abc", cookieattr.defaults())
//         Ok(h)  => println(h)
//         Err(_) => println("refused")
// ```
pub fn set_cookie(name: Str, value: Str,
                  a: cookieattr.CookieAttrs) -> Result<Str, cookieattr.CookieError> []
    check(name, value, a)!
    Ok(set_cookie_unchecked(name, value, a))

// Write a `Set-Cookie` value without checking anything.
//
// For a proxy passing a header through, and for a test that wants a
// header a browser will drop.
pub fn set_cookie_unchecked(name: Str, value: Str, a: cookieattr.CookieAttrs) -> Str []
    var out = "${name}=${value}"
    if a.domain != ""
        out = out + "; Domain=${a.domain}"
    if a.path_value != ""
        out = out + "; Path=${a.path_value}"
    match a.life
        CookieLifeSession    => ()
        CookieLifeExpires(t) =>
            out = out + "; Expires=" + format_expires(t)
        CookieLifeMaxAge(s)  =>
            out = out + "; Max-Age=${s}"
    if a.secure
        out = out + "; Secure"
    if a.http_only
        out = out + "; HttpOnly"
    let ss = cookieattr.same_site_name(a.same_site)
    if ss != ""
        out = out + "; SameSite=" + ss
    if a.partitioned
        out = out + "; Partitioned"
    out

// Append a `Set-Cookie` value to a cursor the caller owns, answering
// the number of bytes appended or the refusal.
//
// The cursor must have room for `set_cookie_len` bytes.  Writing past
// its end panics, as every cursor write does.
pub fn set_cookie_into(name: Str, value: Str, a: cookieattr.CookieAttrs,
                       var dst: Cursor) -> Result<Int, cookieattr.CookieError> []
    let h = set_cookie(name, value, a)!
    dst.put_bytes(bytes.from_str(h))
    Ok(str.len(h))

// How many bytes `set_cookie_unchecked` writes for these arguments,
// which is what `set_cookie` writes when it accepts them.
pub fn set_cookie_len(name: Str, value: Str, a: cookieattr.CookieAttrs) -> Int []
    str.len(set_cookie_unchecked(name, value, a))

// The header that deletes a cookie: an empty value and `Max-Age=0`,
// with the `Domain` and `Path` it was set with.
//
// A browser identifies a cookie by its name, domain and path together
// (RFC 6265bis section 5.7 step 22), so a deletion with a different
// `Domain` or `Path` removes nothing.  The caller passes the attributes
// the cookie was set with, and this replaces the lifetime.
//
// ```novo
// use cookieattr
// use cookiewrite
//
// fn main() [io]
//     match cookiewrite.delete_cookie("sid", cookieattr.defaults())
//         Ok(h)  => println(h)
//         Err(_) => println("refused")
// ```
pub fn delete_cookie(name: Str, a: cookieattr.CookieAttrs) -> Result<Str, cookieattr.CookieError> []
    let gone = CookieAttrs { domain: a.domain, path_value: a.path_value,
                             life: CookieLifeMaxAge(0), secure: a.secure,
                             http_only: a.http_only, same_site: a.same_site,
                             partitioned: a.partitioned }
    set_cookie(name, "", gone)

// Format an `Expires` value as RFC 6265bis section 4.1.1 requires of a
// server: `Sun, 06 Nov 1994 08:49:37 GMT`.
pub fn format_expires(at: civil.CivilDateTime) -> Str []
    let days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    let d = at.date
    let t = at.time
    let wd = days[civil.weekday_number(civil.weekday(d)) - 1]
    "${wd}, ${two(d.day)} ${months[d.month - 1]} ${pad(d.year, 4)} ${two(t.hour)}:${two(t.minute)}:${two(t.second)} GMT"

// Write a `Cookie` request header value from a list of pairs:
// `name=value; name=value`.
//
// Refuses a pair whose name or value the grammar does not allow.
pub fn cookie_header(pairs: [(Str, Str)]) -> Result<Str, cookieattr.CookieError> []
    var parts: [Str] = []
    for p in pairs
        check(p.0, p.1, cookieattr.empty_attrs())!
        list.push(parts, "${p.0}=${p.1}")
    Ok(str.join(parts, "; "))

// A cookie value checked against RFC 6265bis section 4.1.1's
// `cookie-value` grammar, answered as given when it passes.
//
// The quoted form of the grammar admits the same bytes as the bare
// form, so quoting never makes a refused value legal.  A value that
// passes is answered as it was written, quoted or not, and one that
// does not is refused at its first bad byte rather than quoted into a
// value a browser would cut short.
pub fn quote_value(value: Str) -> Result<Str, cookieattr.CookieError> []
    match cookieparse.value_error(value)
        Some(e) => Err(e)
        None    => Ok(value)

// The first problem with a name, a value and its attributes.
fn check(name: Str, value: Str, a: cookieattr.CookieAttrs) -> Result<Unit, cookieattr.CookieError>
    match list.first(cookieattr.check_attrs(name, a))
        Some(e) =>
            return Err(e)
        None    => ()
    match cookieparse.value_error(value)
        Some(e) => Err(e)
        None    => Ok(())

// A number written with at least two digits.
fn two(n: Int) -> Str
    pad(n, 2)

// A number written with at least `w` digits.
fn pad(n: Int, w: Int) -> Str
    str.pad_left("${n}", w, "0")
