// differential_tests.nv — Python's http.cookies and email.utils as a
// second opinion.
//
// Written by tools/differential.py with Python 3.12.3.  The tool's
// docstring says which cases are used and why.

use std.test
use civil
use cookieparse
use cookiewrite

@test
fn test_python_http_cookies_reads_the_same_values() [io]
    test.case("sid=abc")
    test.assert(cookieparse.unquote(cookieparse.get_str("sid=abc", "sid") ?? "<absent>") == "abc")
    test.assert(cookieparse.count("sid=abc") == 1)
    test.case("sid=abc; theme=dark")
    test.assert(cookieparse.unquote(cookieparse.get_str("sid=abc; theme=dark", "sid") ?? "<absent>") == "abc")
    test.assert(cookieparse.unquote(cookieparse.get_str("sid=abc; theme=dark", "theme") ?? "<absent>") == "dark")
    test.assert(cookieparse.count("sid=abc; theme=dark") == 2)
    test.case("a=1; b=2; c=3")
    test.assert(cookieparse.unquote(cookieparse.get_str("a=1; b=2; c=3", "a") ?? "<absent>") == "1")
    test.assert(cookieparse.unquote(cookieparse.get_str("a=1; b=2; c=3", "b") ?? "<absent>") == "2")
    test.assert(cookieparse.unquote(cookieparse.get_str("a=1; b=2; c=3", "c") ?? "<absent>") == "3")
    test.assert(cookieparse.count("a=1; b=2; c=3") == 3)
    test.case("token=eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.abc-_")
    test.assert(cookieparse.unquote(cookieparse.get_str("token=eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.abc-_", "token") ?? "<absent>") == "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.abc-_")
    test.assert(cookieparse.count("token=eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.abc-_") == 1)
    test.case("quoted=\"hello\"")
    test.assert(cookieparse.unquote(cookieparse.get_str("quoted=\"hello\"", "quoted") ?? "<absent>") == "hello")
    test.assert(cookieparse.count("quoted=\"hello\"") == 1)
    test.case("  spaced  =  value  ; next=1")
    test.assert(cookieparse.unquote(cookieparse.get_str("  spaced  =  value  ; next=1", "spaced") ?? "<absent>") == "value")
    test.assert(cookieparse.unquote(cookieparse.get_str("  spaced  =  value  ; next=1", "next") ?? "<absent>") == "1")
    test.assert(cookieparse.count("  spaced  =  value  ; next=1") == 2)
    test.case("empty=; other=x")
    test.assert(cookieparse.unquote(cookieparse.get_str("empty=; other=x", "empty") ?? "<absent>") == "")
    test.assert(cookieparse.unquote(cookieparse.get_str("empty=; other=x", "other") ?? "<absent>") == "x")
    test.assert(cookieparse.count("empty=; other=x") == 2)
    test.case("b64=YWJjZA==")
    test.assert(cookieparse.unquote(cookieparse.get_str("b64=YWJjZA==", "b64") ?? "<absent>") == "YWJjZA==")
    test.assert(cookieparse.count("b64=YWJjZA==") == 1)
    test.case("n1=v1;n2=v2")
    test.assert(cookieparse.unquote(cookieparse.get_str("n1=v1;n2=v2", "n1") ?? "<absent>") == "v1")
    test.assert(cookieparse.unquote(cookieparse.get_str("n1=v1;n2=v2", "n2") ?? "<absent>") == "v2")
    test.assert(cookieparse.count("n1=v1;n2=v2") == 2)
    test.case("__Host-sid=x; __Secure-id=y")
    test.assert(cookieparse.unquote(cookieparse.get_str("__Host-sid=x; __Secure-id=y", "__Host-sid") ?? "<absent>") == "x")
    test.assert(cookieparse.unquote(cookieparse.get_str("__Host-sid=x; __Secure-id=y", "__Secure-id") ?? "<absent>") == "y")
    test.assert(cookieparse.count("__Host-sid=x; __Secure-id=y") == 2)
    test.case("k=a!b#c\$d%e&f'g*h+i-j.k^l_m`n|o~p")
    test.assert(cookieparse.unquote(cookieparse.get_str("k=a!b#c\$d%e&f'g*h+i-j.k^l_m`n|o~p", "k") ?? "<absent>") == "a!b#c\$d%e&f'g*h+i-j.k^l_m`n|o~p")
    test.assert(cookieparse.count("k=a!b#c\$d%e&f'g*h+i-j.k^l_m`n|o~p") == 1)

@test
fn test_python_email_utils_writes_the_same_dates() [io]
    test.case("Thu, 01 Jan 1970 00:00:00 GMT")
    let d0 = civil.datetime(civil.date(1970, 1, 1)!, civil.time_of(0, 0, 0, 0)!)
    test.assert(cookiewrite.format_expires(d0) == "Thu, 01 Jan 1970 00:00:00 GMT")
    match cookieparse.parse_expires("Thu, 01 Jan 1970 00:00:00 GMT")
        Ok(back) => test.assert(civil.compare_datetime(back, d0) == 0)
        Err(_)   => test.assert(false)
    test.case("Sun, 06 Nov 1994 08:49:37 GMT")
    let d1 = civil.datetime(civil.date(1994, 11, 6)!, civil.time_of(8, 49, 37, 0)!)
    test.assert(cookiewrite.format_expires(d1) == "Sun, 06 Nov 1994 08:49:37 GMT")
    match cookieparse.parse_expires("Sun, 06 Nov 1994 08:49:37 GMT")
        Ok(back) => test.assert(civil.compare_datetime(back, d1) == 0)
        Err(_)   => test.assert(false)
    test.case("Tue, 29 Feb 2000 23:59:59 GMT")
    let d2 = civil.datetime(civil.date(2000, 2, 29)!, civil.time_of(23, 59, 59, 0)!)
    test.assert(cookiewrite.format_expires(d2) == "Tue, 29 Feb 2000 23:59:59 GMT")
    match cookieparse.parse_expires("Tue, 29 Feb 2000 23:59:59 GMT")
        Ok(back) => test.assert(civil.compare_datetime(back, d2) == 0)
        Err(_)   => test.assert(false)
    test.case("Tue, 19 Jan 2038 03:14:08 GMT")
