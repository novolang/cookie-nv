// cookieseal.nv — signed and encrypted cookie values.
//
// A signed value can be read by the client and cannot be changed by it.
// An encrypted value can be neither read nor changed.  A user id or a
// role the client already knows goes in a signed cookie; anything the
// client should not see goes in an encrypted one.  The two pairs of
// functions, `sign` with `verify` and `encrypt` with `decrypt`, make
// the choice visible where the cookie is written.
//
// The signature is HMAC-SHA256 (RFC 2104) from crypto-nv.  The cipher
// is supplied by the caller as a `CookieCipher`, a pair of named
// functions and three lengths for an authenticated encryption scheme
// with associated data (AEAD), so the caller chooses the primitive.
//
// The cookie's name is authenticated.  It is part of the message the
// MAC covers, and for an encrypted value it is the associated data and
// part of the plaintext.  A value sealed for one cookie therefore does
// not verify under another name read with the same key.  `verify` and
// `decrypt` take the name the caller expects.
//
// A key set is a list, newest first.  The first key signs and encrypts;
// every key verifies and decrypts, in order, and the index of the key
// that matched is answered.  A key is rotated by putting a new key in
// front and dropping the old one a session lifetime later.
//
// A sealed value is base64url without padding (RFC 4648 section 5).  A
// signed value is the 32-byte tag followed by the value's bytes.  An
// encrypted value is the nonce followed by the cipher's output.

use std.bytes
use std.list
use std.str
use cookieattr
use digest
use hashing

// A key set: the one that signs, and the ones that still verify.
//
// `keys[0]` signs.  Every key verifies, in order.
pub struct CookieKeys
    keys: [Bytes]

// One key, as a key set.
pub fn one_key(key: Bytes) -> CookieKeys []
    CookieKeys { keys: [key] }

// A key set from a list, newest first.  The list is copied.
pub fn keys_of(keys: [Bytes]) -> CookieKeys []
    CookieKeys { keys: list.clone(keys) }

// The key set with a new signing key in front and the old keys after
// it, in their order.
pub fn rotate(k: CookieKeys, newest: Bytes) -> CookieKeys []
    CookieKeys { keys: list.concat([newest], k.keys) }

// How many keys the set holds.
pub fn key_count(k: CookieKeys) -> Int []
    list.len(k.keys)

// How long a signing key should be, in bytes: 32, the output length of
// SHA-256 (RFC 2104 section 3).
pub fn key_len() -> Int []
    hashing.SHA256_DIGEST_BYTES

// ── Signed ───────────────────────────────────────────────────────────

// Sign a value under a key set's first key.
//
// The MAC covers the name, `=` and the value.  The answer is the tag and
// the value, in that order, as base64url without padding.  A key set
// with no keys signs nothing, and the answer is the empty string, which
// no key set verifies.
//
// ```novo
// use cookieseal
//
// fn main() [io]
//     let k = cookieseal.one_key(bytes.zeros(32))
//     println(cookieseal.sign("sid", "u=42", k))
// ```
pub fn sign(name: Str, value: Str, k: CookieKeys) -> Str []
    match list.first(k.keys)
        Some(key) =>
            let v = bytes.from_str(value)
            let sealed = tag(key, name, v) + v
            b64url(sealed)
        None      => ""

// Verify a signed value, answering it and the index of the key that
// matched.
//
// `name` is the name the caller expects the cookie to have.  A value
// signed under another name, a changed value, and a value signed by a
// key not in the set are all refused with `CookieSealBroken`.  Tags are
// compared in constant time.
pub fn verify(name: Str, sealed: Str,
              k: CookieKeys) -> Result<(Str, Int), cookieattr.CookieError> []
    let raw = unb64url(sealed) ?? bytes.zeros(0)
    let n = bytes.len(raw)
    if n < hashing.SHA256_DIGEST_BYTES
        return Err(CookieSealBroken(name))
    let got = bytes.slice(raw, 0, hashing.SHA256_DIGEST_BYTES)
    let value = bytes.slice(raw, hashing.SHA256_DIGEST_BYTES, n)
    var i = 0
    for key in k.keys
        if digest.ct_eq(got, tag(key, name, value))
            return Ok((bytes.to_str(value), i))
        i = i + 1
    Err(CookieSealBroken(name))

// The value inside a signed cookie, without verifying it.
//
// A signed value is readable by the client, so this reveals nothing the
// client does not have.  For logging what arrived, not for trusting it.
pub fn peek_signed(sealed: Str) -> ?Str []
    let raw = unb64url(sealed) ?? bytes.zeros(0)
    if bytes.len(raw) < hashing.SHA256_DIGEST_BYTES
        return None
    Some(bytes.to_str(bytes.slice(raw, hashing.SHA256_DIGEST_BYTES, bytes.len(raw))))

// ── Encrypted ────────────────────────────────────────────────────────

// A cipher the caller supplies: an AEAD as two named functions.
//
// `seal(key, nonce, associated_data, plaintext)` answers the ciphertext
// with its tag appended.  `open_box(key, nonce, associated_data,
// sealed)` answers the plaintext, or `None` when the tag does not
// verify.
pub struct CookieCipher
    // A name for the cipher, for a diagnostic.
    name: Str
    // The key length, the nonce length and the tag length, in bytes.
    key_bytes: Int
    nonce_bytes: Int
    tag_bytes: Int
    seal: fn(Bytes, Bytes, Bytes, Bytes) -> Bytes
    open_box: fn(Bytes, Bytes, Bytes, Bytes) -> ?Bytes

// A cipher description.
pub fn cipher(name: Str, key_bytes: Int, nonce_bytes: Int, tag_bytes: Int,
              seal: fn(Bytes, Bytes, Bytes, Bytes) -> Bytes,
              open_box: fn(Bytes, Bytes, Bytes, Bytes) -> ?Bytes) -> CookieCipher []
    CookieCipher { name: name, key_bytes: key_bytes, nonce_bytes: nonce_bytes,
                   tag_bytes: tag_bytes, seal: seal, open_box: open_box }

// Encrypt a value under a key set's first key with a nonce the caller
// supplies.
//
// The associated data is the cookie's name and the plaintext is the
// name, `=` and the value.  The answer is the nonce and the cipher's
// output, as base64url without padding.  A nonce that is not
// `nonce_len(c)` bytes, a first key that is not `c.key_bytes` bytes, and
// an empty key set are refused with `CookieSealBroken`.
//
// A nonce must never repeat under one key.  This package has no source
// of randomness, so the nonce is the caller's.
pub fn encrypt(name: Str, value: Str, k: CookieKeys, c: CookieCipher,
               nonce: Bytes) -> Result<Str, cookieattr.CookieError> []
    if bytes.len(nonce) != c.nonce_bytes
        return Err(CookieSealBroken(name))
    let key = list.first(k.keys) ?? bytes.zeros(0)
    if bytes.len(key) != c.key_bytes
        return Err(CookieSealBroken(name))
    // The binding names its type.  The 0.13.0 compiler frees the answer
    // of a call through a function value only when it does.
    let box: Bytes = c.seal(key, nonce, bytes.from_str(name), bytes.from_str("${name}=${value}"))
    let sealed = nonce + box
    Ok(b64url(sealed))

// Decrypt a value, answering it and the index of the key that opened
// it.
//
// Each key of the right length is tried in order.  A key opens the value
// when the cipher's `open_box` answers a plaintext that begins with
// `name` and `=`.  Anything else is `CookieSealBroken`.
pub fn decrypt(name: Str, sealed: Str, k: CookieKeys,
               c: CookieCipher) -> Result<(Str, Int), cookieattr.CookieError> []
    let raw = unb64url(sealed) ?? bytes.zeros(0)
    let n = bytes.len(raw)
    if n < c.nonce_bytes
        return Err(CookieSealBroken(name))
    let nonce = bytes.slice(raw, 0, c.nonce_bytes)
    let box = bytes.slice(raw, c.nonce_bytes, n)
    let head = "${name}="
    var i = 0
    for key in k.keys
        if bytes.len(key) == c.key_bytes
            // Typed for the same reason as the binding in `encrypt`.
            let opened: ?Bytes = c.open_box(key, nonce, bytes.from_str(name), box)
            match opened
                Some(plain) =>
                    let text = bytes.to_str(plain)
                    if str.starts_with(text, head)
                        return Ok((str.slice(text, str.len(head), str.len(text)), i))
                None        => ()
        i = i + 1
    Err(CookieSealBroken(name))

// How many random bytes `encrypt` needs for a nonce under this cipher.
pub fn nonce_len(c: CookieCipher) -> Int []
    c.nonce_bytes

// Whether a value has the shape this package writes: base64url without
// padding, decoding to at least 16 bytes.
//
// Every signed value holds a 32-byte tag, and every encrypted value a
// nonce and a tag.  A value that fails this was not sealed here; a value
// that passes and then fails `verify` or `decrypt` was changed or sealed
// under another key.
pub fn is_sealed(sealed: Str) -> Bool []
    match unb64url(sealed)
        Some(raw) => bytes.len(raw) >= 16
        None      => false

// ── Key derivation ───────────────────────────────────────────────────

// Two keys derived from one master secret: one to sign with and one to
// encrypt with.
pub struct CookieDerived
    signing: Bytes
    encryption: Bytes

// Derive the signing key and the encryption key from a master secret.
//
// Each is HKDF-Expand (RFC 5869 section 2.3) with the master as the
// pseudorandom key and one output block: HMAC-SHA256 of the master over
// a label and the byte 0x01.  The labels are `cookie-nv signing` and
// `cookie-nv encryption`.
pub fn derive(master: Bytes) -> CookieDerived []
    CookieDerived { signing: expand(master, "cookie-nv signing"),
                    encryption: expand(master, "cookie-nv encryption") }

// How long a master secret should be, in bytes: 32.
pub fn master_len() -> Int []
    hashing.SHA256_DIGEST_BYTES

// ── Helpers ──────────────────────────────────────────────────────────

// The HMAC-SHA256 tag over a name, `=` and a value.
//
// Here and below, a `Bytes` sum is bound to a name before it is passed
// to a call; the 0.13.0 compiler leaks a sum written as the argument.
fn tag(key: Bytes, name: Str, value: Bytes) -> Bytes
    let msg = bytes.from_str("${name}=") + value
    hashing.hmac_sha256(key, msg, bytes.zeros(hashing.SHA256_DIGEST_BYTES))

// One HKDF-Expand block of 32 bytes.
fn expand(prk: Bytes, label: Str) -> Bytes
    let info = bytes.from_str(label) + bytes.u8(1)
    hashing.hmac_sha256(prk, info, bytes.zeros(hashing.SHA256_DIGEST_BYTES))

// Bytes as base64url without padding.
fn b64url(b: Bytes) -> Str
    let std64 = bytes.to_base64(b)
    str.replace(str.replace(str.replace(std64, "+", "-"), "/", "_"), "=", "")

// Base64url without padding, decoded, or `None` for text outside the
// alphabet or of a length no encoding has.
fn unb64url(s: Str) -> ?Bytes
    let n = str.len(s)
    if n % 4 == 1
        return None
    for i in 0..n
        let b = str.byte_at_or(s, i, 0)
        if not (b >= 'A' and b <= 'Z' or b >= 'a' and b <= 'z' or b >= '0' and b <= '9' or b == '-' or b == '_')
            return None
    let std64 = str.replace(str.replace(s, "-", "+"), "_", "/")
    bytes.from_base64(std64 + str.repeat("=", (4 - n % 4) % 4))
